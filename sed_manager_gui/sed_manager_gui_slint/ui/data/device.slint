import { Status } from "status.slint";
import { Uid } from "uid.slint";
import { Sector } from "sector.slint";

export enum Ssc {
    none,
    enterprise,
    opal-1,
    opal-2,
    opalite,
    pyrite-1,
    pyrite-2,
    ruby,
    key-per-io,
}

export struct DiscoveryProperty {
    name: string,
    value: string,
}

export struct DiscoveryFeature {
    name: string,
    properties: [DiscoveryProperty],
}

export struct Discovery {
    status: Status,
    common-features: [DiscoveryFeature],
    ssc-features: [DiscoveryFeature],
}

export struct DeviceFeatures {
    ssc: Ssc,
    secondary-sp-name: string,
    locking-supported: bool,
    kpio-supported: bool,
    media-encryption-supported: bool,
    psid-supported: bool,
    activate-supported: bool,
    revert-by-sid-supported: bool,
}

export struct DeviceConfig {
    sid-msid-pin-differ: bool,
    secondary-sp-enabled: bool,
}

export struct Identity {
    status: Status,
    name: string,
    serial: string,
    path: string,
    firmware: string,
    interface: string,
    security-commands: bool,
    is-removable: bool,
}

export struct Geometry {
    logical_sector_size: int,
    logical_sector_count: Sector,
}

export struct Alignment {
    alignment_required: bool,
    alignment_granularity: Sector,
    lowest_aligned_lba: Sector,
}

export struct ComIdStatus {
    connected: bool,
    com-id: int,
    com-id-ext: int,
    receptive: bool,
    status: string,
}

export struct ProtocolProperty {
    name: string,
    host: string,
    device: string,
    outbound: string,
    inbound: string,
}

export struct StackStatus {
    com-id: ComIdStatus,
    protocol: [ProtocolProperty],
}

export struct CommandStatus {
    tper-busy: bool,
    session-busy: bool,
    secondary-session-active: bool,
}

export struct LockingRange {
    uid: Uid,
    name: string,
    common_name: string,
    start: Sector,
    end: Sector,
    read-lock-enabled: bool,
    write-lock-enabled: bool,
    read-locked: bool,
    write-locked: bool,
    is-global-range: bool,
}

export struct LockingRangeAccess {
    locking-range: Uid,
    authority: Uid,
    read-unlock: bool,
    write-unlock: bool,
    erase: bool,
}

export struct MbrAccess {
    authority: Uid,
    set-done: bool,
}

export struct AccessControl {
    authority-names: [string],
    locking-range-names: [string],
    locking-range-accesses: [LockingRangeAccess],
    mbr-accesses: [MbrAccess],
}

export struct Authority {
    uid: Uid,
    name: string,
    common_name: string,
    enabled: bool,
    is-class: bool,
    has-password: bool,
    is-admin: bool,
}

export struct Mbr {
    supported: bool,
    size: Sector,
    enabled: bool,
    done: bool,
    upload-progress: float,
    writing-in-progress: bool,
}

export struct SecurityProvider {
    uid: Uid,
    name: string,
    locking_ranges: [LockingRange],
    authorities: [Authority],
    access-control: AccessControl,
    mbr: Mbr,
    // Derive this with a filter-map from `authorities`. Delete it as soon as Slint
    // supports in-Slint filter-map on models.
    individual-authority-names: [string],
    individual-authority-uids: [Uid],
}

export struct Device {
    identity: Identity,
    features: DeviceFeatures,
    geometry: Geometry,
    alignment: Alignment,
    discovery: Discovery,
    config: DeviceConfig,
    stack-status: StackStatus,
    command-status: CommandStatus,
    admin-sp: SecurityProvider,
    locking-sp: SecurityProvider,
}

export global SscLib {
    public pure function accent-color(ssc: Ssc) -> color {
        if ssc == Ssc.enterprise {
            #105DC7
        }
        else if ssc == Ssc.opal-1 {
            #4EBEF2
        }
        else if ssc == Ssc.opal-2 {
            #4EBEF2
        }
        else if ssc == Ssc.opalite {
            #71D1B8
        }
        else if ssc == Ssc.pyrite-1 {
            #CFB959
        }
        else if ssc == Ssc.pyrite-2 {
            #CFB959
        }
        else if ssc == Ssc.ruby {
            #C4316A
        }
        else if ssc == Ssc.key-per-io {
            #913500
        }
        else {
            #B0B0B0
        }
    }
}
