import { ComboBox, LineEdit, Button } from "std-widgets.slint";
import { ToastCard, ToastLevel, ConfirmPopup } from "../../widgets/lib.slint";
import {
    RevertScope,
    RevertAuthority,
    CommandStatus,
    DeviceConfig,
} from "../../data/lib.slint";
import { Ssc, DeviceFeatures } from "../../data/device.slint";
import { RevertScopeLib, RevertAuthorityLib } from "../../data/activity.slint";
import { MainWindowGeometry } from "../../main_window_geometry.slint";

export component RevertDeviceView {
    in property <DeviceFeatures> features;
    in property <DeviceConfig> config;
    in property <CommandStatus> command-status;

    callback revert-device(scope: RevertScope, authority: RevertAuthority, password: string);

    private property <[RevertScope]> revert-scopes: {
        if features.ssc == enterprise {
            [everything]
        } else {
            [secondary, everything]
        }
    };
    private property <[RevertAuthority]> revert-authorities: {
        if features.ssc == enterprise && features.psid-supported {
            [psid]
        } else if revert-scope == everything {
            [sid, psid]
        } else {
            [sid]
        }
    };
    private property <RevertScope> revert-scope: revert-scopes[revert-scope-selector.current-index];
    private property <RevertAuthority> revert-authority: revert-authorities[revert-authority-selector.current-index];

    VerticalLayout {
        spacing: 0.5rem;
        alignment: start;

        Text {
            text: "Revert scope:";
        }

        revert-scope-selector := ComboBox {
            accessible-id: "revert-scope";
            model: {
                if revert-scopes.length == 1 {
                    [RevertScopeLib.to-string(revert-scopes[0], features.ssc)]
                } else {
                    [
                        RevertScopeLib.to-string(revert-scopes[0], features.ssc),
                        RevertScopeLib.to-string(revert-scopes[1], features.ssc)
                    ]
                }
            };
            current-index: 0;
            enabled: self.model.length > 1;
        }

        Text {
            text: "Authenticate as:";
        }

        revert-authority-selector := ComboBox {
            model: {
                if revert-authorities.length == 1 {
                    [RevertAuthorityLib.to-string(revert-authorities[0])]
                } else {
                    [
                        RevertAuthorityLib.to-string(revert-authorities[0]),
                        RevertAuthorityLib.to-string(revert-authorities[1])
                    ]
                }
            };
            current-index: 0;
            enabled: self.model.length > 1;
        }

        Text {
            text: "Password:";
        }

        password := LineEdit {
            input-type: InputType.password;
            accessible-id: "revert-password";
        }

        confirm-revert := ConfirmPopup {
            x: -root.absolute-position.x;
            y: -root.absolute-position.y;
            width: MainWindowGeometry.width;
            height: MainWindowGeometry.height;
            title: @tr("Revert {}?", RevertScopeLib.to-string(revert-scope, features.ssc));
            message: "Your configuration will be lost. If your drive is currently encrypted, your data will be crypto-shredded and cannot be restored in any way.";

            confirmed => {
                revert-device(revert-scope, revert-authority, password.text)
            }
        }

        Button {
            text: "Revert";
            accessible-id: "revert-submit";
            primary: true;
            enabled: !command-status.session-busy && !command-status.tper-busy;
            clicked => {
                confirm-revert.show()
            }
        }
    }
}
